[Unit]
# Re-register Funnel with Tailscale's ingress on every boot.
#
# This exists because of a trap that cost us a false "it survives reboots":
# `tailscale funnel status` reports the LOCAL stored config, and after a reboot
# it happily says "Funnel on" while the public ingress resets every TLS
# handshake. The stored config survives; the registration with the control plane
# does not — observed 2026-07-26 after a reboot plus an external-IP change.
#
# So local status is NOT proof. This unit forces a real re-registration (off,
# then on — re-applying "on" over an existing "on" is a no-op) and then checks
# the PUBLIC endpoint, logging the HTTP status so `journalctl -u psos-funnel`
# answers "is the URL actually reachable?" rather than "is it configured?".
Description=Re-register Tailscale Funnel for psos and verify the public URL
After=tailscaled.service psos.service network-online.target
Wants=tailscaled.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# tailscaled needs to be logged in and to have picked up the (new) external IP
# before funnel registration will stick.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do tailscale status >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/tailscale funnel --https=443 off
ExecStart=/usr/bin/tailscale funnel --bg 3000
ExecStartPost=/usr/local/bin/psos-funnel-verify

[Install]
WantedBy=multi-user.target
